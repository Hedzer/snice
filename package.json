{
  "name": "snice",
  "version": "7.1.1",
  "type": "module",
  "description": "A decorator-driven web component library with routing, controllers, daemons, and 130+ UI components. For better coding-agent results, run npx snice init-ai.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "browser": "dist/index.iife.js",
  "types": "dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.esm.js",
      "require": "./dist/symbols.cjs"
    },
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "import": "./dist/transitions.esm.js",
      "require": "./dist/transitions.cjs"
    },
    "./react": {
      "types": "./adapters/react/index.d.ts",
      "import": "./adapters/react/index.js"
    },
    "./react/*": {
      "types": "./adapters/react/*.d.ts",
      "import": "./adapters/react/*.js"
    },
    "./components/theme/theme.css": "./dist/components/theme/theme.css",
    "./components/custom-elements": {
      "types": "./dist/components/custom-elements.d.ts"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "bin": {
    "snice": "./bin/snice.js"
  },
  "files": [
    "dist",
    "adapters",
    ".agents",
    "bin",
    "README.md",
    "docs",
    "custom-elements.json",
    "vscode.html-custom-data.json"
  ],
  "keywords": [
    "web components",
    "web-components",
    "webcomponents",
    "web-component",
    "custom elements",
    "custom-elements",
    "custom-element",
    "shadow dom",
    "typescript",
    "framework",
    "decorators",
    "vanilla js",
    "frontend",
    "spa",
    "routing",
    "no virtual dom",
    "lightweight",
    "ui",
    "ui-components",
    "component-library",
    "reactive",
    "zero-dependencies",
    "html",
    "css",
    "web standards",
    "lit alternative",
    "stencil alternative",
    "components"
  ],
  "author": "hedzer",
  "license": "MIT",
  "homepage": "https://snice.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedzer/snice.git"
  },
  "bugs": {
    "url": "https://gitlab.com/Hedzer/snice/-/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node tooling/dev/dev.js",
    "dev:framework": "vite",
    "dev:website": "npm run build:website:full && vite --port 52891",
    "predev:storybook": "test -f dist/index.esm.js || npm run build:distribution",
    "dev:storybook": "storybook dev -p 6006 --no-open",
    "preview": "vite preview",
    "prebuild": "[ -z \"$NEXT_VERSION\" ] && npm run sync:versions || true",
    "build": "npm run build:distribution && npm run build:cdn && npm run build:react",
    "build:distribution": "rm -rf dist && npm run generate:metadata && rollup -c && npm run build:types && node tooling/build/embed-sourcemap-sources.mjs dist",
    "build:types": "tsc --project packages/components/tsconfig.json --emitDeclarationOnly && cp packages/components/custom-elements.d.ts dist/components/custom-elements.d.ts",
    "prebuild:cdn": "test -f dist/index.esm.js || npm run build:distribution",
    "build:cdn": "rollup -c rollup.config.cdn.js && node tooling/website/sync-component-assets.js && node tooling/website/update-cdn-sizes.js",
    "prebuild:react": "test -f dist/index.d.ts || npm run build:distribution",
    "build:react": "npm run generate:react-adapters && tsc --project adapters/react/tsconfig.json && node tooling/build/embed-sourcemap-sources.mjs adapters/react",
    "build:testing": "rollup -c rollup.config.test.js && node tooling/build/embed-sourcemap-sources.mjs dist",
    "build:website": "node tooling/website/sync-component-assets.js && node tooling/website/build-website.js && node tooling/website/build-showcases.js",
    "build:website:full": "npm run build:cdn && npm run build:website",
    "build:storybook": "storybook build",
    "generate:metadata": "node tooling/generators/generate-component-metadata.js && node tooling/generators/generate-analyzer-contracts.js",
    "generate:analyzer-contracts": "node tooling/generators/generate-analyzer-contracts.js",
    "generate:react-adapters": "node tooling/generators/generate-react-adapters.js && node tooling/generators/generate-analyzer-contracts.js",
    "generate:react-tests": "node tooling/generators/generate-react-tests.js",
    "sync:versions": "node tooling/generators/sync-template-versions.js",
    "check:metadata": "node tooling/generators/generate-component-metadata.js --check && node tooling/generators/generate-analyzer-contracts.js --check",
    "pretest": "npm run sync:versions && npm run build:website",
    "test": "npm run test:full",
    "test:full": "node tooling/testing/run-full-tests.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --config vitest.core-coverage.config.ts --coverage",
    "test:source": "npm run build:testing && vitest run",
    "test:distribution": "npm run build:distribution && npm run build:testing && npm run test:distribution:prepared",
    "test:distribution:prepared": "TEST_BUILT=true vitest run",
    "test:cdn": "npm run build:cdn && npm run test:cdn:prepared",
    "test:cdn:prepared": "npm run test:cdn:artifacts && npm run test:cdn:runtime",
    "test:cdn:artifacts": "vitest run tests/cdn-builds.test.ts",
    "test:cdn:runtime": "vitest run tests/cdn-runtime.test.ts",
    "test:react": "npm run build:react && npm run test:react:prepared",
    "test:react:prepared": "vitest run tests/react-adapters",
    "test:website": "vitest run tests/website.test.ts",
    "gauntlet": "node tooling/testing/run-gauntlet.js",
    "postinstall": "node ./bin/postinstall.js",
    "test:browser": "npm run test:browser:framework && npm run test:browser:website",
    "test:browser:framework": "npm run build:distribution && npm run test:browser:framework:prepared",
    "test:browser:framework:prepared": "node tooling/testing/run-live-tests.js --workers=4",
    "test:browser:website": "npm run build:website:full && node tooling/website/build-deploy.js && npm run test:browser:website:prepared",
    "test:browser:website:prepared": "node tooling/testing/run-website-browser-tests.js --workers=4",
    "test:browsers:install": "playwright install chromium firefox webkit",
    "test:live:components": "npx playwright test tests/live/components --config=tests/playwright.config.ts",
    "test:live:templates": "npx playwright test tests/live/templates --config=tests/playwright.config.ts",
    "prerelease": "export NEXT_VERSION=$(node tooling/release/get-next-version.js) && node tooling/generators/sync-template-versions.js $NEXT_VERSION && npm run build",
    "release": "semantic-release --no-ci",
    "postrelease": "npm run deploy:website",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "deploy:website": "npm run build:website:full && node tooling/website/build-deploy.js && npx wrangler deploy",
    "screenshots:website": "node tooling/website/take-screenshots.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "prestorybook": "test -f dist/index.esm.js || npm run build:distribution",
    "build-storybook": "npm run build:storybook",
    "sync-versions": "npm run sync:versions",
    "build:core": "npm run build:distribution",
    "build:showcases": "node tooling/website/build-showcases.js",
    "build:test": "npm run build:testing",
    "test:src": "npm run test:source",
    "test:built": "npm run test:distribution",
    "test:cdn-runtime": "npm run test:cdn:runtime",
    "test:react-adapters": "npm run test:react",
    "test:live": "node tooling/testing/run-live-tests.js",
    "test:browser:core": "npm run test:browser:framework",
    "test:browser:new": "npm run test:browser",
    "test:all": "npm run test:full",
    "release:dry": "npm run release:dry-run",
    "website:build": "npm run build:website",
    "website:build:full": "npm run build:website:full",
    "website:dev": "npm run dev:website",
    "website:deploy": "npm run deploy:website",
    "website:test": "npm run test:website",
    "website:test:render": "npm run build:distribution && npm run test:browser:website",
    "website:test:render:built": "npm run test:browser:website",
    "screenshots": "npm run screenshots:website"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/html": "^8.6.12",
    "@storybook/html-vite": "^8.6.12",
    "@swc/core": "^1.13.5",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.0.0",
    "axe-core": "^4.11.3",
    "clean-css": "^5.3.3",
    "fast-check": "^4.9.0",
    "happy-dom": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.50.2",
    "semantic-release": "^24.2.7",
    "storybook": "^8.6.12",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.7",
    "vite": "^5.0.10",
    "vitest": "^1.0.0",
    "wrangler": "^4.72.0"
  },
  "dependencies": {
    "pica-route": "^1.1.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  }
}
